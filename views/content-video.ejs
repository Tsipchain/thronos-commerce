<!doctype html><html lang="<%= lang %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= lang==='el'?(video.titleEl||video.titleEn):(video.titleEn||video.titleEl) %> – <%= config.storeName %></title><link rel="stylesheet" href="/styles.css"><style>:root{--accent:<%= config.accentColor || '#f97316' %>}body{margin:0;background:#090909;color:#f5f5f5;font-family:<%= config.fontFamily || 'system-ui' %>}main{max-width:1000px;margin:auto;padding:24px 18px 60px}a{color:var(--accent)}.player{margin-top:22px;aspect-ratio:16/9;background:#000;border:1px solid #333;border-radius:9px;overflow:hidden}.player video,.player iframe{width:100%;height:100%;border:0}.lock{margin-top:22px;padding:34px;text-align:center;border:1px solid #4b2d1b;background:#17110e;border-radius:9px}.button{display:inline-block;margin-top:12px;padding:10px 16px;background:var(--accent);color:#111;text-decoration:none;border-radius:5px;font-weight:800}.badge{color:var(--accent);font-size:.8rem;text-transform:uppercase}</style></head><body><main><a href="<%= withTenantLink('/content') %>">← <%= lang==='el'?'Βιβλιοθήκη':'Library' %></a><p class="badge"><%= video.accessLevel==='public'?'Public':'Subscribers' %></p><h1><%= lang==='el'?(video.titleEl||video.titleEn):(video.titleEn||video.titleEl) %></h1><p><%= lang==='el'?(video.descriptionEl||video.descriptionEn):(video.descriptionEn||video.descriptionEl) %></p><% if(allowed){ const directExternal=video.sourceType==='external' && /\.(mp4|webm)(\?.*)?$/i.test(playbackUrl||''); %><div class="player"><% if(video.sourceType==='uploaded'||directExternal){ %><video controls preload="metadata"><source src="<%= playbackUrl %>"></video><% }else{ %><iframe src="<%= playbackUrl %>" allowfullscreen allow="autoplay; encrypted-media; picture-in-picture"></iframe><% } %></div><% }else{ %><section class="lock"><h2>🔒 <%= lang==='el'?'Περιεχόμενο συνδρομητών':'Subscriber content' %></h2><p><%= subscription.status==='expired'?(lang==='el'?'Η συνδρομή σου έχει λήξει. Ανανέωσέ την για πρόσβαση.':'Your subscription has expired. Renew it to regain access.'):(lang==='el'?'Απόκτησε συνδρομή για να παρακολουθήσεις το βίντεο.':'Subscribe to watch this video.') %></p><a class="button" href="<%= withTenantLink(user?'/account':'/signup') %>"><%= subscription.status==='expired'?(lang==='el'?'Ανανέωση συνδρομής':'Renew subscription'):(lang==='el'?'Απόκτησε συνδρομή':'Subscribe') %></a></section><% } %></main></body></html>
