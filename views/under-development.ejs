<!DOCTYPE html>
<html lang="<%= lang %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= config.storeName %> — <%= lang === 'el' ? 'Υπό Κατασκευή' : 'Under Development' %></title>
    <link rel="icon" href="<%= withTenantLink('/favicon.ico', { v: (config.favicon && config.favicon.updatedAt) || '' }) %>" />
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      <% const isEko = (config.theme && config.theme.presetId === 'eukolakis_classic_diy'); %>
      <% if (isEko) { %>
      :root {
        --ud-bg: #0b0d12;
        --ud-surface: #141820;
        --ud-accent: #c4902e;
        --ud-accent-glow: rgba(196, 144, 46, .15);
        --ud-border: rgba(100, 110, 140, .28);
        --ud-text: #d0d5e0;
        --ud-text-strong: #edf0f6;
        --ud-text-muted: #64707f;
      }
      <% } else { %>
      :root {
        --ud-bg: #f8fafc;
        --ud-surface: #ffffff;
        --ud-accent: <%= config.accentColor || '#e8922d' %>;
        --ud-accent-glow: rgba(232, 146, 45, .08);
        --ud-border: #e2e8f0;
        --ud-text: #334155;
        --ud-text-strong: #0f172a;
        --ud-text-muted: #94a3b8;
      }
      <% } %>
      body {
        font-family: <%= config.fontFamily || 'system-ui, -apple-system, sans-serif' %>;
        background: var(--ud-bg);
        color: var(--ud-text);
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
        <% if (isEko) { %>
        background-image:
          repeating-linear-gradient(0deg, rgba(196,144,46,.02) 0px, rgba(196,144,46,.02) 1px, transparent 1px, transparent 56px),
          repeating-linear-gradient(90deg, rgba(196,144,46,.02) 0px, rgba(196,144,46,.02) 1px, transparent 1px, transparent 56px);
        <% } %>
      }
      .ud-card {
        background: var(--ud-surface);
        border: 1px solid var(--ud-border);
        border-top: 3px solid var(--ud-accent);
        border-radius: 20px;
        padding: 48px 36px 40px;
        max-width: 520px;
        width: 100%;
        text-align: center;
        box-shadow: 0 24px 64px rgba(0,0,0,<%= isEko ? '.55' : '.08' %>);
      }
      .ud-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 72px; height: 72px;
        background: var(--ud-accent-glow);
        border-radius: 50%;
        margin-bottom: 24px;
        font-size: 32px;
      }
      .ud-logo {
        max-height: 56px;
        max-width: 200px;
        margin-bottom: 20px;
      }
      .ud-badge {
        display: inline-block;
        background: var(--ud-accent);
        color: #fff;
        font-size: .72rem;
        font-weight: 800;
        border-radius: 6px;
        padding: 4px 14px;
        margin-bottom: 20px;
        letter-spacing: .06em;
        text-transform: uppercase;
      }
      .ud-card h1 {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--ud-text-strong);
        margin-bottom: 14px;
        line-height: 1.3;
      }
      .ud-card p {
        color: var(--ud-text-muted);
        line-height: 1.7;
        font-size: .92rem;
        margin-bottom: 10px;
      }
      .ud-progress {
        margin: 28px auto 8px;
        width: 80%;
        height: 6px;
        background: var(--ud-border);
        border-radius: 3px;
        overflow: hidden;
      }
      .ud-progress-bar {
        height: 100%;
        width: 65%;
        background: linear-gradient(90deg, var(--ud-accent), #f0b84a);
        border-radius: 3px;
        animation: ud-pulse 2s ease-in-out infinite;
      }
      @keyframes ud-pulse {
        0%, 100% { opacity: .7; }
        50% { opacity: 1; }
      }
      .ud-contact {
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid var(--ud-border);
        font-size: .82rem;
        color: var(--ud-text-muted);
      }
      .ud-contact a {
        color: var(--ud-accent);
        text-decoration: none;
        font-weight: 600;
      }
      .ud-contact a:hover { text-decoration: underline; }
      .ud-admin-link {
        display: inline-block;
        margin-top: 16px;
        font-size: .78rem;
        color: var(--ud-text-muted);
        text-decoration: none;
      }
      .ud-admin-link:hover { color: var(--ud-accent); }
    </style>
  </head>
  <body>
    <div class="ud-card">
      <% if (config.logoPath && config.logoPath !== '/logo.svg') { %>
        <img class="ud-logo" src="<%= config.logoPath %>" alt="<%= config.storeName %>" />
        <br />
      <% } %>
      <div class="ud-icon">🚧</div>
      <div class="ud-badge"><%= lang === 'el' ? 'ΥΠΟ ΚΑΤΑΣΚΕΥΗ' : 'UNDER DEVELOPMENT' %></div>
      <h1><%= lang === 'el' ? 'Ετοιμάζουμε κάτι νέο!' : 'Something new is coming!' %></h1>
      <p>
        <%= lang === 'el'
          ? 'Το κατάστημά μας βρίσκεται υπό κατασκευή. Σύντομα θα είμαστε κοντά σας με νέα προϊόντα και υπηρεσίες.'
          : 'Our store is currently under development. We will be back soon with new products and services.' %>
      </p>
      <div class="ud-progress">
        <div class="ud-progress-bar"></div>
      </div>
      <p style="font-size:.78rem;"><%= lang === 'el' ? 'Εργαζόμαστε πάνω σε αυτό...' : 'Working on it...' %></p>

      <div class="ud-contact">
        <p><%= lang === 'el' ? 'Για ερωτήσεις επικοινωνήστε μαζί μας' : 'For questions, contact us' %></p>
        <p><strong><%= config.storeName %></strong></p>
      </div>

      <a class="ud-admin-link" href="<%= withTenantLink('/admin/login') %>">
        <%= lang === 'el' ? '🔒 Είσοδος Διαχειριστή' : '🔒 Admin Login' %>
      </a>
    </div>
  </body>
</html>
