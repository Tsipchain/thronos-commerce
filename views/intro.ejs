<!DOCTYPE html>
<html lang="<%= lang %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= config.storeName %> · Intro</title>
    <link rel="icon" href="<%= withTenantLink('/favicon.ico', { v: (config.favicon && config.favicon.updatedAt) || '' }) %>" />
    <link rel="stylesheet" href="/styles.css" />
    <%
      /* ── Intro mode resolution ──────────────────────────────────────────────
         Supported modes: 'basic' | 'assembly' | 'video'
         'basic'    — logo + welcome text splash (default / fallback)
         'assembly' — brand elements animate in from different directions
         'video'    — video player with sound toggle
         Auto-fallback: 'video' without a URL degrades to 'assembly' if logo
         is present, otherwise 'basic'.
      ──────────────────────────────────────────────────────────────────────── */
      const _storedMode  = ((homepage.introMode) || 'basic').toLowerCase();
      const _hasVideo    = !!(homepage.introVideoUrl);
      const _hasLogo     = !!(config.logoPath);
      const effectiveMode =
          _storedMode === 'fullscreen'             ? 'fullscreen'
        : _storedMode === 'video'    && _hasVideo  ? 'video'
        : _storedMode === 'assembly'               ? 'assembly'
        : _storedMode === 'video'    && _hasLogo   ? 'assembly'   /* video chosen, no URL → degrade */
        : 'basic';
      const _introBackgroundUrl = (homepage.introBackgroundUrl) || '';
      const _introAudit = introAssetAudit || {};
      const _bannerAudit = _introAudit.headerBanner || null;
      const _introImgSource = (homepage.introImageSource || 'dedicated').toLowerCase();
      const _brandIdentitySrc = _introImgSource === 'logo'
        ? (config.logoPath || '')
        : (_bannerAudit && _bannerAudit.exists && _bannerAudit.url)
          ? _bannerAudit.url
          : (config.logoPath || '');
    %>
    <style>
      /* ── Theme tokens ────────────────────────────────────────────────────── */
      <% if (isEukolakisClassic) { %>
      :root {
        --ix-bg:           #0b0d12;
        --ix-surface:      #141820;
        --ix-surface-2:    #1c2030;
        --ix-accent:       #c4902e;
        --ix-accent-light: #dba83c;
        --ix-border:       rgba(100,110,140,.28);
        --ix-text:         #d0d5e0;
        --ix-text-strong:  #edf0f6;
        --ix-text-muted:   #64707f;
      }
      body {
        margin: 0;
        background: var(--ix-bg);
        background-image:
          repeating-linear-gradient(0deg,  rgba(196,144,46,.025) 0px, rgba(196,144,46,.025) 1px, transparent 1px, transparent 56px),
          repeating-linear-gradient(90deg, rgba(196,144,46,.025) 0px, rgba(196,144,46,.025) 1px, transparent 1px, transparent 56px);
        color: var(--ix-text);
        font-family: system-ui, -apple-system, sans-serif;
      }
      .intro-card {
        width: min(960px, 96vw);
        background: var(--ix-surface);
        border: 1px solid var(--ix-border);
        border-top: 2px solid var(--ix-accent);
        border-radius: 16px;
        padding: 0;
        box-shadow: 0 40px 80px rgba(0,0,0,.7), 0 0 0 1px rgba(196,144,46,.06) inset;
        overflow: hidden;
      }
      .intro-brand-bar {
        display: flex; align-items: center; gap: 12px;
        padding: 14px 20px;
        border-bottom: 1px solid var(--ix-border);
        background: rgba(11,13,18,.6);
      }
      .intro-brand-banner {
        flex: 1;
        border: 1px solid rgba(196,144,46,.34);
        border-radius: 10px;
        padding: 8px 10px;
        background: linear-gradient(145deg, rgba(17,24,39,.88), rgba(12,16,24,.95));
      }
      .intro-brand-banner img {
        width: 100%;
        max-height: 44px;
        object-fit: contain;
        object-position: left center;
        display: block;
      }
      .intro-brand-logo { max-height: 32px; max-width: 120px; object-fit: contain; filter: brightness(1.05); }
      .intro-brand-name { font-size: .84rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--ix-text-strong); }
      /* video mode */
      .intro-player-wrap { position: relative; background: #000; }
      .intro-player-wrap video { width: 100%; max-height: 72vh; display: block; object-fit: cover; }
      .intro-player-overlay {
        position: absolute; bottom: 0; left: 0; right: 0;
        background: linear-gradient(to top, rgba(11,13,18,.85) 0%, transparent 60%);
        padding: 20px 20px 16px;
        display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; flex-wrap: wrap;
      }
      .intro-player-cta { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
      .intro-sound {
        border: 1px solid rgba(196,144,46,.4); background: rgba(20,24,32,.8);
        color: var(--ix-text); border-radius: 8px; padding: 9px 14px;
        cursor: pointer; font-size: .84rem; backdrop-filter: blur(4px);
        transition: border-color .14s, background .14s;
      }
      .intro-sound:hover { border-color: var(--ix-accent); background: rgba(196,144,46,.12); }
      /* assembly mode */
      .intro-assembly-wrap {
        padding: 56px 28px 40px; text-align: center;
        min-height: 240px; display: flex; flex-direction: column; align-items: center;
        background: linear-gradient(155deg, #14182a 0%, #0d1018 60%, #0b0d12 100%);
        background-image:
          repeating-linear-gradient(0deg,  rgba(196,144,46,.03) 0px, rgba(196,144,46,.03) 1px, transparent 1px, transparent 48px),
          repeating-linear-gradient(90deg, rgba(196,144,46,.03) 0px, rgba(196,144,46,.03) 1px, transparent 1px, transparent 48px),
          linear-gradient(155deg, #14182a 0%, #0d1018 60%, #0b0d12 100%);
      }
      /* basic / fallback mode */
      .intro-no-video {
        padding: 48px 24px 32px; text-align: center;
        background: linear-gradient(145deg, #14182a 0%, #0d1018 55%, #0b0d12 100%);
        background-image:
          repeating-linear-gradient(0deg,  rgba(196,144,46,.03) 0px, rgba(196,144,46,.03) 1px, transparent 1px, transparent 48px),
          repeating-linear-gradient(90deg, rgba(196,144,46,.03) 0px, rgba(196,144,46,.03) 1px, transparent 1px, transparent 48px),
          linear-gradient(145deg, #14182a 0%, #0d1018 55%, #0b0d12 100%);
      }
      .intro-no-video-name     { font-size: clamp(1.6rem, 5vw, 2.4rem); font-weight: 900; letter-spacing: .06em; text-transform: uppercase; color: var(--ix-text-strong); margin: 0 0 6px; }
      .intro-no-video-tagline  { color: var(--ix-text-muted); font-size: .9rem; margin: 0 0 28px; }
      .quick-back-btn          { background: var(--ix-surface-2); border: 1px solid var(--ix-border); color: var(--ix-text); }
      <% } else { %>
      :root {
        --ix-bg:           #030712;
        --ix-surface:      rgba(15,23,42,.9);
        --ix-surface-2:    #0f172a;
        --ix-accent:       #0ea5e9;
        --ix-accent-light: #38bdf8;
        --ix-border:       rgba(148,163,184,.35);
        --ix-text:         #e2e8f0;
        --ix-text-strong:  #f1f5f9;
        --ix-text-muted:   rgba(255,255,255,.55);
      }
      body { margin: 0; background: radial-gradient(circle at 10% 10%, #111827, #020617 72%); color: var(--ix-text); font-family: system-ui, sans-serif; }
      .intro-card { width: min(980px,96vw); background: var(--ix-surface); border: 1px solid var(--ix-border); border-radius: 16px; padding: 18px; box-shadow: 0 28px 58px rgba(0,0,0,.5); overflow: hidden; }
      .intro-brand-bar { padding: 0 0 12px; border-bottom: 1px solid var(--ix-border); margin-bottom: 12px; }
      .intro-brand-name { font-size: 1.05rem; font-weight: 700; color: var(--ix-text-strong); }
      .intro-brand-logo { max-height: 36px; max-width: 160px; object-fit: contain; }
      .intro-player-wrap { border-radius: 10px; overflow: hidden; background: #000; }
      .intro-player-wrap video { width: 100%; max-height: 72vh; display: block; object-fit: cover; }
      .intro-player-overlay { margin-top: 14px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: center; }
      .intro-sound { border: 1px solid var(--ix-border); background: #0b1220; color: var(--ix-text); border-radius: 8px; padding: 9px 12px; cursor: pointer; transition: border-color .14s; }
      .intro-sound:hover { border-color: var(--ix-accent); }
      .intro-assembly-wrap { padding: 52px 28px 36px; text-align: center; min-height: 220px; display: flex; flex-direction: column; align-items: center; background: radial-gradient(circle at 50% 30%, #111827, #020617 80%); }
      .intro-no-video { padding: 32px 20px; text-align: center; }
      .intro-no-video-name     { font-size: 2rem; font-weight: 800; margin: 0 0 8px; color: var(--ix-text-strong); }
      .intro-no-video-tagline  { color: var(--ix-text-muted); font-size: .9rem; margin: 0 0 24px; }
      .quick-back-btn          { background: var(--ix-surface-2); color: var(--ix-text); border: none; }
      <% } %>

      /* ── Fullscreen mode ─────────────────────────────────────────────────── */
      .fs-intro {
        position: fixed; inset: 0; z-index: 9999;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        overflow: hidden;
      }
      .fs-intro__bg {
        position: absolute; inset: 0; z-index: 0;
        background-color: #0a0a0a;
        background-size: cover; background-position: center center; background-repeat: no-repeat;
      }
      .fs-intro__bg--fallback {
        background-image:
          radial-gradient(ellipse 40% 50% at 8% 50%, rgba(230,126,34,.08) 0%, transparent 70%),
          radial-gradient(ellipse 40% 50% at 92% 50%, rgba(230,126,34,.06) 0%, transparent 70%),
          radial-gradient(ellipse 60% 30% at 50% 100%, rgba(230,126,34,.1) 0%, transparent 60%),
          radial-gradient(ellipse 80% 40% at 50% 0%, rgba(20,20,30,.95) 0%, transparent 80%),
          linear-gradient(180deg, #0d0d12 0%, #0a0a0f 40%, #111115 100%);
      }
      .fs-intro__bg::after {
        content: ''; position: absolute; inset: 0;
        background:
          radial-gradient(ellipse 80% 60% at 50% 55%, transparent 30%, rgba(0,0,0,.55) 100%),
          linear-gradient(to bottom, rgba(0,0,0,.25) 0%, transparent 30%, transparent 60%, rgba(0,0,0,.5) 100%);
      }
      .fs-intro__content {
        position: relative; z-index: 1;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        text-align: center; padding: 20px;
        animation: fs-fadeIn .8s ease-out both;
      }
      @keyframes fs-fadeIn {
        from { opacity: 0; transform: scale(.94) translateY(12px); }
        to   { opacity: 1; transform: none; }
      }
      .fs-intro__logo {
        max-width: min(620px, 88vw); max-height: 40vh;
        object-fit: contain; filter: drop-shadow(0 8px 32px rgba(0,0,0,.7));
        margin-bottom: 32px;
        animation: fs-logoIn 1s ease-out .2s both;
      }
      @keyframes fs-logoIn {
        from { opacity: 0; transform: scale(.85) translateY(20px); }
        to   { opacity: 1; transform: none; }
      }
      .fs-intro__loading-wrap {
        width: min(420px, 80vw); margin-bottom: 28px;
        animation: fs-fadeIn .6s ease-out .6s both;
      }
      .fs-intro__loading-track {
        width: 100%; height: 6px;
        background: rgba(255,255,255,.12);
        border-radius: 3px; overflow: hidden;
        border: 1px solid rgba(255,255,255,.06);
      }
      .fs-intro__loading-bar {
        width: 0%; height: 100%;
        background: linear-gradient(90deg, #e67e22, #f39c12, #e67e22);
        border-radius: 3px;
        transition: width .05s linear;
        box-shadow: 0 0 12px rgba(243,156,18,.5);
      }
      .fs-intro__loading-text {
        margin-top: 8px; font-size: .78rem; letter-spacing: .05em;
        color: rgba(255,255,255,.5); font-weight: 600; text-transform: uppercase;
      }
      .fs-intro__enter-btn {
        display: inline-flex; align-items: center; gap: 14px;
        background: linear-gradient(180deg, #f5a623 0%, #e67e22 40%, #c15e0a 100%);
        color: #000; font-weight: 900; font-size: clamp(1.1rem, 3.5vw, 1.5rem);
        font-family: 'Impact', 'Arial Black', sans-serif;
        letter-spacing: .1em; text-transform: uppercase;
        border: 3px solid #1a1a1a;
        outline: 3px solid rgba(245,166,35,.7);
        border-radius: 6px; padding: 18px 52px;
        cursor: pointer; text-decoration: none;
        position: relative; overflow: hidden;
        box-shadow:
          0 6px 28px rgba(230,126,34,.5),
          inset 0 2px 0 rgba(255,255,255,.35),
          inset 0 -2px 4px rgba(0,0,0,.3),
          0 0 0 1px rgba(0,0,0,.4);
        text-shadow: 0 1px 2px rgba(0,0,0,.3);
        transition: transform .2s, box-shadow .2s, filter .2s;
        opacity: 0; animation: fs-fadeIn .5s ease-out 2.2s forwards;
      }
      .fs-intro__enter-btn::before {
        content: '';
        position: absolute; inset: 2px; border-radius: 3px;
        border: 1px solid rgba(255,200,80,.4);
        pointer-events: none;
      }
      .fs-intro__enter-btn::after {
        content: '';
        position: absolute; top: 0; left: -100%; width: 60%; height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,.2), transparent);
        transition: left .6s;
      }
      .fs-intro__enter-btn:hover::after { left: 100%; }
      .fs-intro__enter-btn:hover {
        transform: translateY(-3px) scale(1.03);
        box-shadow: 0 10px 40px rgba(230,126,34,.65), inset 0 2px 0 rgba(255,255,255,.4);
        filter: brightness(1.08);
      }
      .fs-intro__enter-btn:active { transform: translateY(0) scale(.98); }
      .fs-intro__enter-btn svg { width: 22px; height: 22px; fill: currentColor; }

      .fs-intro__enter-btn--image {
        background: transparent; border: none; outline: none;
        box-shadow: none; padding: 0; border-radius: 0;
        text-shadow: none;
      }
      .fs-intro__enter-btn--image::before,
      .fs-intro__enter-btn--image::after { display: none; }
      .fs-intro__enter-btn--image img {
        max-width: min(420px, 80vw); max-height: 30vh;
        object-fit: contain; display: block;
        filter: drop-shadow(0 8px 24px rgba(0,0,0,.6));
        transition: transform .25s, filter .25s;
      }
      .fs-intro__enter-btn--image:hover img {
        transform: scale(1.06);
        filter: drop-shadow(0 12px 36px rgba(230,126,34,.5)) brightness(1.1);
      }
      .fs-intro__enter-btn--image:active img { transform: scale(.97); }

      .fs-intro__footer {
        position: fixed; bottom: 0; left: 0; right: 0; z-index: 2;
        display: flex; align-items: flex-end; justify-content: space-between;
        padding: 16px 24px;
        pointer-events: none;
        animation: fs-fadeIn .5s ease-out 1.6s both;
      }
      .fs-intro__socials {
        display: flex; gap: 12px; pointer-events: auto;
      }
      .fs-intro__socials a {
        display: flex; align-items: center; justify-content: center;
        width: 32px; height: 32px; border-radius: 6px;
        background: rgba(255,255,255,.08); color: rgba(255,255,255,.6);
        transition: background .2s, color .2s; text-decoration: none;
      }
      .fs-intro__socials a:hover { background: rgba(243,156,18,.2); color: #f39c12; }
      .fs-intro__socials svg { width: 16px; height: 16px; fill: currentColor; }
      .fs-intro__tagline {
        font-family: 'Brush Script MT', 'Segoe Script', cursive;
        font-size: clamp(1rem, 3vw, 1.4rem);
        color: rgba(255,255,255,.55); font-style: italic;
        text-align: right; line-height: 1.2;
      }

      /* ── Assembly animation — shared across all themes ───────────────────── */
      .assembly-el {
        opacity: 0;
        will-change: transform, opacity;
        transition: opacity .52s cubic-bezier(.4,0,.2,1), transform .52s cubic-bezier(.4,0,.2,1);
      }
      .assembly-el--logo { transform: translateX(-30px) scale(.96); transition-delay: 0s; }
      .assembly-el--bar  { transform: scaleX(0); transform-origin: left center; transition-delay: .18s; }
      .assembly-el--name { transform: translateX(30px);                          transition-delay: .10s; }
      .assembly-el--tag  { transform: translateY(10px);                          transition-delay: .32s; }
      /* JS adds this class to fire all transitions */
      .intro-assembly-wrap.intro-assembled .assembly-el { opacity: 1; transform: none; }

      .assembly-logo-img  { max-height: 72px; max-width: 220px; object-fit: contain; margin-bottom: 18px; }
      .assembly-logo-plate {
        width: min(560px, 94%);
        border: 1px solid rgba(196,144,46,.34);
        border-radius: 12px;
        padding: 14px 16px;
        margin: 0 auto 18px;
        background: linear-gradient(145deg, rgba(17,24,39,.88), rgba(12,16,24,.95));
        box-shadow: 0 14px 28px rgba(0,0,0,.34);
      }
      .assembly-logo-plate .assembly-logo-img {
        max-height: 86px;
        max-width: 100%;
        margin: 0 auto;
        display: block;
      }
      .assembly-bar-line  { width: 56px; height: 3px; background: var(--ix-accent); border-radius: 2px; margin: 0 auto 16px; }
      .assembly-name-text { font-size: clamp(1.6rem, 5vw, 2.5rem); font-weight: 900; letter-spacing: .06em; text-transform: uppercase; color: var(--ix-text-strong); margin: 0 0 6px; }
      .assembly-tag-text  { color: var(--ix-text-muted); font-size: .9rem; margin: 0 0 28px; }

      /* ── Shared layout ───────────────────────────────────────────────────── */
      .intro-wrap { min-height: 100vh; display: grid; place-items: center; padding: 20px; }
      .intro-actions-row {
        display: flex; gap: 10px; flex-wrap: wrap;
        justify-content: center; align-items: center;
        padding: 16px 20px;
        border-top: 1px solid var(--ix-border);
      }
      .intro-enter {
        border: none; background: var(--ix-accent);
        color: #fff; border-radius: 8px; padding: 12px 28px;
        font-weight: 800; cursor: pointer; font-size: 1rem; letter-spacing: .02em;
        transition: filter .14s, transform .14s;
      }
      .intro-enter:hover  { filter: brightness(1.1); transform: translateY(-2px); }
      .intro-enter:active { transform: translateY(0); }
      .intro-skip {
        color: #94a3b8; text-decoration: none; padding: 6px 12px;
        font-size: .82rem; display: inline-block; transition: color .14s;
      }
      .intro-skip:hover { color: #cbd5e1; }
      .quick-back-btn {
        position: fixed; left: 12px; bottom: 18px; z-index: 1200;
        border-radius: 999px; padding: 10px 14px;
        font-weight: 700; cursor: pointer; box-shadow: 0 10px 24px rgba(2,6,23,.28);
        font-size: .84rem;
      }
    </style>
  </head>
  <body>
    <% if (effectiveMode === 'fullscreen') { %>
    <%# ══════════════════════════════════════════════════════════════════════
         MODE: fullscreen — immersive full-viewport intro (Eukolaki-style)
         ══════════════════════════════════════════════════════════════════════ %>
    <div class="fs-intro" id="fs-intro">
      <div class="fs-intro__bg<% if (!_introBackgroundUrl) { %> fs-intro__bg--fallback<% } %>" id="fs-bg"
        <% if (_introBackgroundUrl) { %>style="background-image:url('<%= _introBackgroundUrl %>')"<% } %>
      ></div>

      <div class="fs-intro__content">
        <% if (_brandIdentitySrc) { %>
          <img class="fs-intro__logo" src="<%= _brandIdentitySrc %>" alt="<%= config.storeName %>" />
        <% } else { %>
          <h1 style="font-size:clamp(2rem,8vw,4rem);font-weight:900;letter-spacing:.08em;text-transform:uppercase;color:#fff;margin:0 0 24px;text-shadow:0 4px 24px rgba(0,0,0,.6);"><%= config.storeName %></h1>
        <% } %>

        <div class="fs-intro__loading-wrap" id="fs-loading">
          <div class="fs-intro__loading-track">
            <div class="fs-intro__loading-bar" id="fs-loading-bar"></div>
          </div>
          <div class="fs-intro__loading-text" id="fs-loading-text">
            <%= lang === 'el' ? 'Φόρτωση...' : 'Loading...' %>
          </div>
        </div>

        <% const _introEnterBtnUrl = (homepage.introEnterButtonUrl) || ''; %>
        <% if (_introEnterBtnUrl) { %>
        <button class="fs-intro__enter-btn fs-intro__enter-btn--image" id="fs-enter" type="button" style="display:none;">
          <img src="<%= _introEnterBtnUrl %>" alt="<%= lang === 'el' ? 'Μπες στο κατάστημα' : 'Enter store' %>" />
        </button>
        <% } else { %>
        <button class="fs-intro__enter-btn" id="fs-enter" type="button" style="display:none;">
          <%= lang === 'el' ? 'ΜΠΕΣ ΣΤΟ ΚΑΤΑΣΤΗΜΑ' : 'ENTER STORE' %>
          <svg viewBox="0 0 24 24"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
        </button>
        <% } %>
      </div>

      <div class="fs-intro__footer">
        <div class="fs-intro__socials">
          <% const _footer = config.footer || {}; %>
          <% if (_footer.facebookUrl) { %>
          <a href="<%= _footer.facebookUrl %>" aria-label="Facebook" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
          </a>
          <% } %>
          <% if (_footer.instagramUrl) { %>
          <a href="<%= _footer.instagramUrl %>" aria-label="Instagram" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <% } %>
          <% if (_footer.youtubeUrl) { %>
          <a href="<%= _footer.youtubeUrl %>" aria-label="YouTube" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <% } %>
          <% if (_footer.tiktokUrl) { %>
          <a href="<%= _footer.tiktokUrl %>" aria-label="TikTok" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
          </a>
          <% } %>
        </div>
        <div class="fs-intro__tagline">
          <% if (isEukolakisClassic) { %>Make<br>it<br>yours<% } else { %><%= (homepage.introTagline) || '' %><% } %>
        </div>
      </div>
    </div>

    <script>
    (function(){
      var nextHref = <%- JSON.stringify(skipHref).replace(/</g, '\\u003c') %>;
      var bar = document.getElementById('fs-loading-bar');
      var btn = document.getElementById('fs-enter');
      var loadText = document.getElementById('fs-loading-text');
      var loadWrap = document.getElementById('fs-loading');
      var progress = 0;
      var duration = 2000;
      var start = null;

      function persistIntroSeen() {
        var days    = 180;
        var expires = new Date(Date.now() + days * 86400000).toUTCString();
        var name    = <%- JSON.stringify(introCookieName || 'intro_seen') %>;
        var lsKey   = <%- JSON.stringify(introStorageKey  || 'intro_seen') %>;
        var secure  = location.protocol === 'https:' ? '; Secure' : '';
        document.cookie = name + '=1; expires=' + expires + '; path=/; SameSite=Lax' + secure;
        try { localStorage.setItem(lsKey, '1'); } catch (_) {}
      }

      function tick(ts) {
        if (!start) start = ts;
        progress = Math.min(((ts - start) / duration) * 100, 100);
        bar.style.width = progress + '%';
        if (progress < 100) {
          requestAnimationFrame(tick);
        } else {
          loadText.textContent = <%- JSON.stringify(lang === 'el' ? 'Έτοιμο!' : 'Ready!').replace(/</g, '\\u003c') %>;
          setTimeout(function() {
            loadWrap.style.transition = 'opacity .4s';
            loadWrap.style.opacity = '0';
            setTimeout(function() {
              loadWrap.style.display = 'none';
              btn.style.display = '';
            }, 400);
          }, 300);
        }
      }
      requestAnimationFrame(tick);

      btn.addEventListener('click', function() {
        persistIntroSeen();
        window.location.href = nextHref;
      });
    })();
    </script>
    <% } else { %>
    <%# ══════════════════════════════════════════════════════════════════════
         MODES: video / assembly / basic (existing card-based intro)
         ══════════════════════════════════════════════════════════════════════ %>
    <button type="button" id="quick-back-btn" class="quick-back-btn"><%= lang === 'el' ? '← Επιστροφή' : '← Back' %></button>
    <div class="intro-wrap">
      <div class="intro-card">

        <%# ── Brand bar: logo + store name (always shown) ── %>
        <div class="intro-brand-bar">
          <% if (isEukolakisClassic && _brandIdentitySrc) { %>
            <div class="intro-brand-banner">
              <img src="<%= _brandIdentitySrc %>" alt="<%= config.storeName %>" />
            </div>
          <% } else if (_brandIdentitySrc) { %>
            <img class="intro-brand-logo" src="<%= _brandIdentitySrc %>" alt="<%= config.storeName %>" />
          <% } %>
          <span class="intro-brand-name"><%= config.storeName %></span>
        </div>

        <%# ── MODE: video ── %>
        <% if (effectiveMode === 'video') { %>
        <div class="intro-player-wrap">
          <video id="intro-video" controls playsinline preload="metadata" muted
            <%= homepage.introPosterUrl ? ('poster="' + homepage.introPosterUrl + '"') : '' %>>
            <source src="<%= homepage.introVideoUrl %>" type="video/mp4" />
          </video>
          <div class="intro-player-overlay">
            <div class="intro-player-cta">
              <button class="intro-sound" id="intro-sound-toggle" type="button">
                <%= lang === 'el' ? '♪ Αναπαραγωγή με ήχο' : '♪ Play with sound' %>
              </button>
            </div>
          </div>
        </div>

        <%# ── MODE: assembly ── %>
        <% } else if (effectiveMode === 'assembly') { %>
        <div class="intro-assembly-wrap" id="intro-assembly-wrap">
          <% if (_brandIdentitySrc) { %>
            <% if (isEukolakisClassic) { %>
              <div class="assembly-el assembly-el--logo assembly-logo-plate">
                <img class="assembly-logo-img" src="<%= _brandIdentitySrc %>" alt="<%= config.storeName %>" />
              </div>
            <% } else { %>
              <img class="assembly-el assembly-el--logo assembly-logo-img"
                  src="<%= _brandIdentitySrc %>" alt="<%= config.storeName %>" />
            <% } %>
          <% } %>
          <div class="assembly-el assembly-el--bar"><div class="assembly-bar-line"></div></div>
          <p class="assembly-el assembly-el--name assembly-name-text"><%= config.storeName %></p>
          <p class="assembly-el assembly-el--tag assembly-tag-text"><%=
            (homepage.introTagline) ||
            (lang === 'el' ? 'Καλώς ορίσατε στο κατάστημά μας.' : 'Welcome to our store.')
          %></p>
        </div>

        <%# ── MODE: basic / fallback ── %>
        <% } else { %>
        <div class="intro-no-video">
          <% if (_brandIdentitySrc) { %>
            <img src="<%= _brandIdentitySrc %>" alt="<%= config.storeName %>"
              style="max-height:88px;max-width:280px;margin:0 auto 18px;display:block;object-fit:contain;" />
          <% } %>
          <p class="intro-no-video-name"><%= config.storeName %></p>
          <p class="intro-no-video-tagline"><%=
            (homepage.introTagline) ||
            (lang === 'el' ? 'Καλώς ορίσατε στο κατάστημά μας.' : 'Welcome to our store.')
          %></p>
        </div>
        <% } %>

        <%# ── Enter / skip actions ── %>
        <div class="intro-actions-row">
          <button class="intro-enter" id="intro-enter">
            <%= lang === 'el' ? 'Είσοδος στο κατάστημα →' : 'Enter store →' %>
          </button>
          <a class="intro-skip" id="intro-skip" href="<%= skipHref %>">
            <%= lang === 'el' ? 'Παράλειψη' : 'Skip' %>
          </a>
        </div>
      </div>
    </div>

    <script>
      (function(){
        var nextHref = <%- JSON.stringify(skipHref).replace(/</g, '\\u003c') %>;
        var videoEl  = document.getElementById('intro-video');
        var soundBtn = document.getElementById('intro-sound-toggle');

        function persistIntroSeen() {
          var days    = 180;
          var expires = new Date(Date.now() + days * 86400000).toUTCString();
          var name    = <%- JSON.stringify(introCookieName || 'intro_seen') %>;
          var lsKey   = <%- JSON.stringify(introStorageKey  || 'intro_seen') %>;
          var secure  = location.protocol === 'https:' ? '; Secure' : '';
          document.cookie = name + '=1; expires=' + expires + '; path=/; SameSite=Lax' + secure;
          try { localStorage.setItem(lsKey, '1'); } catch (_) {}
        }

        if (soundBtn && videoEl) {
          soundBtn.addEventListener('click', function() {
            videoEl.muted = !videoEl.muted;
            var muteLabel   = <%- JSON.stringify(lang === 'el' ? '♪ Αναπαραγωγή με ήχο' : '♪ Play with sound').replace(/</g, '\\u003c') %>;
            var unmuteLabel = <%- JSON.stringify(lang === 'el' ? '✕ Σίγαση' : '✕ Mute').replace(/</g, '\\u003c') %>;
            soundBtn.textContent = videoEl.muted ? muteLabel : unmuteLabel;
            if (videoEl.paused) videoEl.play().catch(function(){});
          });
        }

        /* ── Assembly: trigger CSS transitions after first paint ── */
        var assemblyWrap = document.getElementById('intro-assembly-wrap');
        if (assemblyWrap) {
          requestAnimationFrame(function() {
            requestAnimationFrame(function() {
              assemblyWrap.classList.add('intro-assembled');
            });
          });
        }

        var enterBtn = document.getElementById('intro-enter');
        if (enterBtn) {
          enterBtn.addEventListener('click', function() {
            persistIntroSeen();
            window.location.href = nextHref;
          });
        }

        var skipEl = document.getElementById('intro-skip');
        if (skipEl) skipEl.addEventListener('click', persistIntroSeen);

        var backBtn = document.getElementById('quick-back-btn');
        if (backBtn) {
          backBtn.addEventListener('click', function() {
            if (history.length > 1 && document.referrer && document.referrer.indexOf(location.origin) === 0) return history.back();
            location.href = nextHref;
          });
        }
      })();
    </script>
    <% } %>
  </body>
</html>
