<!doctype html><html lang="<%= lang %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= lang === 'el' ? 'Βίντεο οδηγιών' : 'Installation guide' %> – <%= config.storeName %></title><link rel="stylesheet" href="/styles.css"><style>
:root{--accent:<%= config.accentColor || '#f97316' %>}body{margin:0;background:#090909;color:#f5f5f5;font-family:<%= config.fontFamily || 'system-ui' %>}main{max-width:600px;margin:auto;padding:60px 24px;text-align:center}.icon{font-size:3.5rem;margin-bottom:18px}.title{font-size:1.4rem;font-weight:700;margin:0 0 10px}.sub{color:#aaa;font-size:.95rem;margin:0 0 28px;line-height:1.5}.product{color:var(--accent);font-size:.88rem;margin:0 0 28px}.back{display:inline-block;padding:10px 20px;background:var(--accent);color:#111;text-decoration:none;border-radius:6px;font-weight:700;font-size:.9rem}
</style></head><body><main><div class="icon">🎬</div><h1 class="title"><%= lang === 'el' ? 'Βίντεο οδηγιών' : 'Installation guide' %></h1><p class="sub"><%= lang === 'el' ? 'Σύντομα διαθέσιμο! Ετοιμάζουμε αναλυτικό βίντεο εγκατάστασης.' : 'Coming soon! We are preparing a detailed installation video.' %></p><% if (productName) { %><p class="product"><%= productName %></p><% } %><a class="back" href="<%= withTenantLink('/') %>"><%= lang === 'el' ? '← Επιστροφή στο κατάστημα' : '← Back to store' %></a></main></body></html>
