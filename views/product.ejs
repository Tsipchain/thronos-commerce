      body.eukolakis-classic.eko-header-clean .store-header { position:static; top:auto; display:grid; grid-template-columns:auto minmax(0,1fr) auto auto; align-items:center; min-height:64px; padding:0 22px !important; overflow:visible; background:#090909 !important; border-bottom:1px solid #242424 !important; box-shadow:none !important; }
      body.eko-header-clean .store-header::before,
      body.eko-header-clean .store-header::after,
      body.eko-header-clean .eko-header-bg-logo { display:none !important; content:none !important; }
      body.eko-header-clean .header-main-row { display:contents; }
      body.eko-header-clean .logo-title { grid-column:1; grid-row:1; }
      body.eko-header-clean .header-auth-actions { display:none !important; }
      body.eko-header-clean .eko-header-compact-logo .eko-compact-sub { display:none; }
      body.eko-header-clean .header-nav-row { display:contents; }
      body.eko-header-clean .header-nav-row .main-nav { grid-column:2; grid-row:1; padding:0 22px; background:transparent; min-width:0; }
      body.eko-header-clean .header-nav-row .main-nav ul { justify-content:center; gap:24px; }
      body.eko-header-clean .header-nav-row li a { background:none !important; border:0 !important; box-shadow:none !important; min-width:0 !important; padding:12px 0 !important; }
      body.eko-header-clean .header-nav-row li a::before,
      body.eko-header-clean .eko-nav-plate-fallback { display:none !important; content:none !important; animation:none !important; }
      body.eko-header-clean .header-nav-row li a { position:relative; }
