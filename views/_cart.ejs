<%# ── Shared floating cart widget ────────────────────────────────────────── %>
<%# Include this in any storefront page EXCEPT /checkout.                     %>
<style>
  #floating-cart {
    position: fixed; right: 24px; bottom: 24px; z-index: 1200;
    width: 52px; height: 52px; border-radius: 50%;
    background: var(--primary-color, #4f46e5); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem; cursor: grab; box-shadow: 0 4px 14px rgba(0,0,0,.25);
    user-select: none; touch-action: none;
  }
  #floating-cart:active { transform: scale(.93); }
  #cart-badge {
    position: absolute; top: -4px; right: -4px;
    background: #ef4444; color: #fff; border-radius: 50%;
    width: 20px; height: 20px; font-size: .72rem; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
  }
  #cart-panel {
    display: none; position: fixed; right: 84px; bottom: 24px; z-index: 1201;
    width: 300px; background: #fff; border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0,0,0,.18); padding: 16px;
  }
  #cart-panel h4 { margin: 0 0 10px; font-size: .95rem; }
  #cart-items { list-style: none; padding: 0; margin: 0 0 8px; }
  #cart-items li {
    display: flex; align-items: center; gap: 6px;
    padding: 6px 0; border-bottom: 1px solid #f3f4f6; font-size: .84rem;
  }
  #cart-items li .ci-name { flex: 1; }
  #cart-items li .ci-controls { display:flex;align-items:center;gap:5px; }
  #cart-items li .ci-qty-btn { min-width:30px;height:30px;border:1px solid #d1d5db;border-radius:6px;background:#fff;cursor:pointer;font-weight:800; }
  #cart-items li .ci-qty { min-width:22px;text-align:center;font-weight:700; }
  #cart-items li .ci-price { white-space: nowrap; }
  #cart-items li .ci-remove {
    cursor: pointer; color: #ef4444; font-size: 1rem; line-height: 1;
    background: none; border: none; padding: 0 2px; flex-shrink: 0;
  }
  #cart-empty-msg { color: #aaa; font-style: italic; font-size: .85rem; }
  #cart-subtotal { font-weight: 600; font-size: .9rem; margin: 6px 0; }
  #cart-checkout-btn {
    display: block; margin-top: 10px; text-align: center;
    background: var(--primary-color, #4f46e5); color: #fff;
    border-radius: var(--button-radius, 4px); padding: 9px 14px;
    text-decoration: none; font-size: .88rem; font-weight: 600;
  }
  #cart-checkout-btn:hover { opacity: .88; }
  #cart-clear-all-btn {
    display: block;
    width: 100%;
    margin-top: 8px;
    border: 1px solid #fecaca;
    background: #fef2f2;
    color: #b91c1c;
    border-radius: var(--button-radius, 4px);
    padding: 8px 10px;
    font-size: .84rem;
    font-weight: 600;
    cursor: pointer;
  }
  #cart-clear-all-btn:hover { background: #fee2e2; }
  @media (max-width:480px) {
    #cart-panel { width:calc(100vw - 24px);right:12px;bottom:84px;max-height:calc(100vh - 110px);overflow:auto; }
    #cart-items li { flex-wrap:wrap;gap:8px; }
    #cart-items li .ci-name { flex-basis:100%; }
    #cart-items li .ci-qty-btn { min-width:36px;height:36px; }
  }
</style>

<div id="floating-cart" title="<%= t('storefront.cartTitle') %>">
  🛒
  <span id="cart-badge" style="display:none;">0</span>
</div>
<div id="cart-panel">
  <h4><%= t('storefront.cartTitle') %></h4>
  <ul id="cart-items"></ul>
  <p id="cart-empty-msg"><%= t('storefront.cartEmpty') %></p>
  <p id="cart-subtotal" style="display:none;"></p>
  <a id="cart-checkout-btn" href="<%= withTenantLink('/checkout') %>" style="display:none;"><%= t('storefront.cartCheckout') %></a>
  <button id="cart-clear-all-btn" type="button" style="display:none;"><%= lang === 'el' ? 'Καθαρισμός καλαθιού' : 'Clear cart' %></button>
</div>

<script src="/cart-state.js"></script>
<script>
  (function() {
    const CART_SCOPE = '<%= (tenant && tenant.id) ? tenant.id : "default" %>';
    const CART_KEY   = 'thrc_cart:' + CART_SCOPE;
    const CART_SESSION_KEY = 'thrc_cart_session:' + CART_SCOPE;
    const CART_SNAPSHOT_API = '<%= withTenantLink("/api/checkout/cart-snapshot") %>';
    const POS_KEY    = 'thrc_cart_position';
    const widget     = document.getElementById('floating-cart');
    const panel      = document.getElementById('cart-panel');
    const badge      = document.getElementById('cart-badge');
    const itemsEl    = document.getElementById('cart-items');
    const emptyMsg   = document.getElementById('cart-empty-msg');
    const subtotalEl = document.getElementById('cart-subtotal');
    const checkoutBtn= document.getElementById('cart-checkout-btn');
    const clearAllBtn= document.getElementById('cart-clear-all-btn');
    const cartState = window.ThrcCartState;

    // ── Position persistence ──────────────────────────────────────────
    (function applyPos() {
      try {
        const p = JSON.parse(localStorage.getItem(POS_KEY));
        if (!p) return;
        widget.style.right = 'auto'; widget.style.bottom = 'auto';
        widget.style.left = p.x + 'px'; widget.style.top = p.y + 'px';
      } catch(e) {}
    })();

    function savePos(x, y) {
      localStorage.setItem(POS_KEY, JSON.stringify({ x, y }));
    }

    // ── Drag ─────────────────────────────────────────────────────────
    let dragging = false, startX, startY, origLeft, origTop;

    function onMoveStart(cx, cy) {
      dragging = true; startX = cx; startY = cy;
      const r = widget.getBoundingClientRect();
      origLeft = r.left; origTop = r.top;
      widget.style.right = 'auto'; widget.style.bottom = 'auto';
      widget.style.left = origLeft + 'px'; widget.style.top = origTop + 'px';
    }
    function onMove(cx, cy) {
      if (!dragging) return;
      widget.style.left = (origLeft + cx - startX) + 'px';
      widget.style.top  = (origTop  + cy - startY) + 'px';
    }
    function onMoveEnd(cx, cy) {
      if (!dragging) return; dragging = false;
      const nl = origLeft + cx - startX, nt = origTop + cy - startY;
      savePos(nl, nt);
      if (Math.abs(cx - startX) < 4 && Math.abs(cy - startY) < 4) {
        panel.style.display = panel.style.display === 'block' ? 'none' : 'block';
        if (panel.style.display === 'block') document.dispatchEvent(new CustomEvent('thrc:cart-open'));
      }
    }

    widget.addEventListener('mousedown', function(e) { e.preventDefault(); onMoveStart(e.clientX, e.clientY); });
    document.addEventListener('mousemove', function(e) { onMove(e.clientX, e.clientY); });
    document.addEventListener('mouseup',   function(e) { onMoveEnd(e.clientX, e.clientY); });
    widget.addEventListener('touchstart', function(e) { const t = e.touches[0]; onMoveStart(t.clientX, t.clientY); }, { passive: true });
    document.addEventListener('touchmove', function(e) { const t = e.touches[0]; onMove(t.clientX, t.clientY); }, { passive: true });
    document.addEventListener('touchend',  function(e) { const t = e.changedTouches[0]; onMoveEnd(t.clientX, t.clientY); });

    document.addEventListener('click', function(e) {
      if (!widget.contains(e.target) && !panel.contains(e.target)) {
        panel.style.display = 'none';
      }
    });

    // ── Cart state ────────────────────────────────────────────────────
    function loadCart() {
      try {
        const local = JSON.parse(localStorage.getItem(CART_KEY) || 'null');
        if (Array.isArray(local)) return local;
      } catch(e) {}
      try {
        const session = JSON.parse(sessionStorage.getItem(CART_SESSION_KEY) || 'null');
        if (Array.isArray(session)) return session;
      } catch(e) {}
      return [];
    }
    function syncCartSnapshotToServer(snapshot) {
      try {
        fetch(CART_SNAPSHOT_API, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          keepalive: true,
          body: JSON.stringify({ items: Array.isArray(snapshot) ? snapshot : [] })
        }).catch(function(){});
      } catch (_) {}
    }
    function saveCart(cart) {
      const payload = JSON.stringify(cart || []);
      localStorage.setItem(CART_KEY, payload);
      try { sessionStorage.setItem(CART_SESSION_KEY, payload); } catch (_) {}
      syncCartSnapshotToServer(cart || []);
    }

    function changeQuantity(key, delta) {
      const cart = cartState.change(loadCart(), key, delta);
      saveCart(cart);
      renderCart();
    }
    function removeItem(key) {
      const cart = cartState.removeLine(loadCart(), key);
      saveCart(cart);
      renderCart();
    }
    function clearCart() {
      saveCart([]);
      renderCart();
    }

    function renderCart() {
      const cart = loadCart();
      const visibleCart = cartState.visibleItems(cart);
      const total = cartState.subtotal(cart);
      const count = cartState.badgeCount(cart);
      badge.textContent = count;
      badge.style.display = count ? 'flex' : 'none';
      var hdrBadge = document.getElementById('eko-cart-badge');
      if (hdrBadge) { hdrBadge.textContent = count; hdrBadge.style.display = count ? '' : 'none'; }
      if (!visibleCart.length) {
        itemsEl.innerHTML = '';
        emptyMsg.style.display = '';
        subtotalEl.style.display = 'none';
        checkoutBtn.style.display = 'none';
        if (clearAllBtn) clearAllBtn.style.display = 'none';
      } else {
        emptyMsg.style.display = 'none';
        itemsEl.innerHTML = visibleCart.map(function(item) {
          const safeKey  = cartState.identity(item).replace(/'/g, "\\'");
          const safeName = (item.name || '?').replace(/</g, '&lt;');
          const snapshotSteps = item.builderSnapshot && Array.isArray(item.builderSnapshot.steps)
            ? item.builderSnapshot.steps.map(function(step) {
                const title = String(step.stepTitle || '').replace(/</g, '&lt;');
                const choice = String(step.skipped ? '<%= lang === "el" ? "Παράλειψη" : "Skipped" %>' : (step.optionTitle || '')).replace(/</g, '&lt;');
                return '<small style="display:block;color:#6b7280;"><strong>' + title + '</strong><br>' + choice + '</small>';
              }).join('')
            : '';
          const optionSummary = snapshotSteps || (item.optionSummary ? '<small style=\"display:block;color:#6b7280;\">' + String(item.optionSummary).replace(/</g,'&lt;') + '</small>' : '');
          const unitPrice = item.builderSnapshot ? (Number(item.builderSnapshot.total) || 0) : (Number(item.price) || 0);
          return '<li>' +
            '<span class="ci-name">' + safeName + optionSummary + '</span>' +
            '<span class="ci-controls"><button class="ci-qty-btn" onclick="thrcChangeCartQty(\'' + safeKey + '\',-1)" aria-label="Μείωση">−</button><span class="ci-qty">' + (item.qty || 1) + '</span><button class="ci-qty-btn" onclick="thrcChangeCartQty(\'' + safeKey + '\',1)" aria-label="Αύξηση">+</button></span>' +
            '<span class="ci-price">' + (unitPrice * (item.qty || 1)).toFixed(2) + ' &euro;</span>' +
            '<button class="ci-remove" onclick="thrcRemoveFromCart(\'' + safeKey + '\')" title="Αφαίρεση γραμμής">&times;</button>' +
            '</li>';
        }).join('');
        subtotalEl.textContent = '<%= t("storefront.cartSubtotal") %>: ' + total.toFixed(2) + ' \u20ac';
        subtotalEl.style.display = '';
        checkoutBtn.style.display = 'block';
        if (clearAllBtn) clearAllBtn.style.display = 'block';
      }
    }

    renderCart();

    // ── Global API ────────────────────────────────────────────────────
    window.thrcAddToCart = function(product) {
      const cart = cartState.add(loadCart(), product);
      saveCart(cart);
      renderCart();
      panel.style.display = 'block';
      document.dispatchEvent(new CustomEvent('thrc:cart-open'));
    };

    window.thrcChangeCartQty = function(key, delta) { changeQuantity(key, delta); };
    window.thrcRemoveFromCart = function(key) { removeItem(key); };
    if (clearAllBtn) {
      clearAllBtn.addEventListener('click', function() {
        if (!loadCart().length) return;
        const msg = '<%= lang === "el" ? "Να αδειάσει όλο το καλάθι;" : "Clear all items from cart?" %>';
        if (!window.confirm(msg)) return;
        clearCart();
      });
    }
  })();
</script>
