<!doctype html><html lang="<%= lang %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Videos – <%= config.storeName %></title><link rel="stylesheet" href="/styles.css"><style>
body{background:#f8fafc}.shell{max-width:1180px;margin:auto;padding:24px}.nav{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:20px}.nav a{color:#1d4ed8}.grid{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(320px,.8fr);gap:22px}.card{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:18px}.videos{width:100%;border-collapse:collapse}.videos th,.videos td{padding:9px;border-bottom:1px solid #e5e7eb;text-align:left;font-size:.84rem}.thumb{width:72px;height:44px;object-fit:cover;background:#111}.badge{padding:3px 7px;border-radius:999px;background:#e2e8f0;font-size:.72rem}.badge.live{background:#dcfce7;color:#166534}.form label{display:block;margin:10px 0;font-size:.84rem}.form input,.form textarea,.form select{width:100%;box-sizing:border-box;padding:8px;border:1px solid #cbd5e1;border-radius:6px}.checks{display:flex;gap:15px}.checks label{display:flex;gap:6px}.checks input{width:auto}.button{background:#ea580c;color:white;border:0;padding:9px 14px;border-radius:6px;cursor:pointer}.danger{background:#b91c1c}@media(max-width:850px){.grid{grid-template-columns:1fr}.videos{display:block;overflow:auto}}
</style></head><body><main class="shell"><nav class="nav"><a href="<%= withTenantLink('/admin') %>">← Admin</a><a href="<%= withTenantLink('/admin/subscribers') %>">Subscribers</a><a href="<%= withTenantLink('/content') %>">View library</a></nav><h1>Videos</h1>
<% if(message){ %><p role="status"><%= message %></p><% } %><% if(error){ %><p role="alert"><%= error %></p><% } %>
<div class="grid"><section class="card"><h2>Video library</h2><table class="videos"><thead><tr><th>Thumbnail</th><th>Title</th><th>Category</th><th>Access</th><th>Status</th><th>Featured</th><th>Order</th><th></th></tr></thead><tbody>
<% videos.forEach(function(video){ %><tr><td><% if(video.thumbnailUrl){ %><img class="thumb" src="<%= video.thumbnailUrl %>" alt=""><% } %></td><td><%= video.titleEl || video.titleEn %></td><td><%= video.category || '—' %></td><td><span class="badge"><%= video.accessLevel %></span></td><td><span class="badge <%= video.published ? 'live' : '' %>"><%= video.published ? 'Published' : 'Draft' %></span></td><td><%= video.featured ? 'Yes' : 'No' %></td><td><%= video.sortOrder %></td><td><a href="<%= withTenantLink('/admin/videos/' + video.id + '/edit') %>">Edit</a><form method="post" action="<%= withTenantLink('/admin/videos/' + video.id + '/delete') %>" style="display:inline"><input type="hidden" name="password" value=""><button class="button danger" type="submit" onclick="this.form.password.value=prompt('Admin password (if session expired)')||'';return confirm('Delete video?')">Delete</button></form></td></tr><% }) %>
</tbody></table></section><section class="card"><h2><%= editing ? 'Edit video' : 'Create video' %></h2><form class="form" method="post" enctype="multipart/form-data" action="<%= withTenantLink('/admin/videos/save') %>" id="video-form"><input type="hidden" name="id" value="<%= editing ? editing.id : '' %>">
<label>Title Greek<input name="titleEl" required value="<%= editing ? editing.titleEl : '' %>"></label><label>Title English<input name="titleEn" value="<%= editing ? editing.titleEn : '' %>"></label><label>Slug<input name="slug" value="<%= editing ? editing.slug : '' %>"></label><label>Description Greek<textarea name="descriptionEl"><%= editing ? editing.descriptionEl : '' %></textarea></label><label>Description English<textarea name="descriptionEn"><%= editing ? editing.descriptionEn : '' %></textarea></label><label>Thumbnail / Media URL<input name="thumbnailUrl" value="<%= editing ? editing.thumbnailUrl : '' %>"></label>
<label>Source<select name="sourceType" id="source-type"><option value="external" <%= !editing || editing.sourceType === 'external' ? 'selected' : '' %>>External video URL</option><option value="uploaded" <%= editing && editing.sourceType === 'uploaded' ? 'selected' : '' %>>Upload video</option></select></label><label id="external-field">External URL<input type="url" name="externalVideoUrl" value="<%= editing ? editing.externalVideoUrl : '' %>"></label><label id="upload-field">MP4 or WebM<input type="file" name="videoFile" accept="video/mp4,video/webm"><progress id="upload-progress" value="0" max="100" hidden></progress></label>
<label>Category / series<input name="category" value="<%= editing ? editing.category : '' %>"></label><label>Access<select name="accessLevel"><option value="public" <%= !editing || editing.accessLevel === 'public' ? 'selected' : '' %>>Public</option><option value="subscriber" <%= editing && editing.accessLevel === 'subscriber' ? 'selected' : '' %>>Subscribers only</option></select></label><label>Duration seconds<input type="number" min="0" name="durationSeconds" value="<%= editing && editing.durationSeconds != null ? editing.durationSeconds : '' %>"></label><label>Sort order<input type="number" name="sortOrder" value="<%= editing ? editing.sortOrder : 0 %>"></label><div class="checks"><label><input type="checkbox" name="published" value="1" <%= editing && editing.published ? 'checked' : '' %>> Published</label><label><input type="checkbox" name="featured" value="1" <%= editing && editing.featured ? 'checked' : '' %>> Featured</label></div><label>Admin password (only needed after session expiry)<input type="password" name="password"></label><p id="upload-status" role="status"></p><button class="button" type="submit">Save video</button></form></section></div></main><script>
const source=document.getElementById('source-type'),external=document.getElementById('external-field'),upload=document.getElementById('upload-field'),form=document.getElementById('video-form'),progress=document.getElementById('upload-progress'),status=document.getElementById('upload-status');function sync(){external.hidden=source.value!=='external';upload.hidden=source.value!=='uploaded'}source.addEventListener('change',sync);sync();form.addEventListener('submit',function(event){if(source.value!=='uploaded'||!form.querySelector('[name=videoFile]').files.length)return;event.preventDefault();progress.hidden=false;progress.value=0;status.textContent='Uploading…';const xhr=new XMLHttpRequest();xhr.open('POST',form.action);xhr.upload.onprogress=function(e){if(e.lengthComputable)progress.value=Math.round(e.loaded/e.total*100)};xhr.onload=function(){if(xhr.status>=200&&xhr.status<400){window.location.href=xhr.responseURL||'<%= withTenantLink('/admin/videos') %>'}else{status.textContent=xhr.responseText||'Upload failed.'}};xhr.onerror=function(){status.textContent='Upload failed.'};xhr.send(new FormData(form))});
</script></body></html>
