<!doctype html><html lang="<%= lang %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= lang==='el'?'Συνδρομητικά Βίντεο':'Video Library' %> – <%= config.storeName %></title><link rel="stylesheet" href="/styles.css"><style>:root{--accent:<%= config.accentColor || '#f97316' %>}body{margin:0;background:#090909;color:#f5f5f5;font-family:<%= config.fontFamily || 'system-ui' %>}header{padding:16px max(18px,calc((100vw - 1180px)/2));display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #292929}header a{color:var(--accent);text-decoration:none}.hero{text-align:center;padding:46px 18px 28px}.hero h1{margin:0 0 8px}.filters{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin:0 0 24px}.filters button{border:1px solid #444;background:#151515;color:#eee;border-radius:5px;padding:8px 12px;cursor:pointer}.filters button.active{border-color:var(--accent);color:var(--accent)}.grid{max-width:1180px;margin:auto;padding:0 18px 60px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.card{display:flex;flex-direction:column;background:#141414;border:1px solid #303030;border-radius:9px;overflow:hidden;color:inherit;text-decoration:none}.card img,.placeholder{width:100%;aspect-ratio:16/9;object-fit:cover;background:#202020}.placeholder{display:grid;place-items:center;color:#777;font-size:2rem}.body{padding:14px;display:flex;flex:1;flex-direction:column}.body h2{font-size:1rem;margin:0 0 7px}.body p{color:#aaa;font-size:.83rem;margin:0 0 14px}.meta{margin-top:auto;display:flex;justify-content:space-between;color:var(--accent);font-size:.76rem}.locked{opacity:.8}.empty{grid-column:1/-1;text-align:center;color:#aaa}@media(max-width:850px){.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:540px){.grid{grid-template-columns:1fr}}</style></head><body><header><a href="<%= withTenantLink('/') %>">← <%= config.storeName %></a><a href="<%= withTenantLink(user?'/account':'/login') %>"><%= user?user.email:(lang==='el'?'Σύνδεση':'Sign in') %></a></header><section class="hero"><h1><%= lang==='el'?'Συνδρομητικά Βίντεο':'Video Library' %></h1><p><%= subscription.active?(lang==='el'?'Η συνδρομή σου είναι ενεργή.':'Your subscription is active.'):(lang==='el'?'Δημόσιοι οδηγοί και περιεχόμενο συνδρομητών.':'Public guides and subscriber content.') %></p></section><div class="filters"><button class="active" data-category="all"><%= lang==='el'?'Όλα':'All' %></button><% Array.from(new Set(videos.map(function(v){return v.category}).filter(Boolean))).forEach(function(category){ %><button data-category="<%= category %>"><%= category %></button><% }) %></div><main class="grid" id="video-grid"><% if(!videos.length){ %><p class="empty"><%= lang==='el'?'Δεν υπάρχουν δημοσιευμένα βίντεο ακόμη.':'No published videos yet.' %></p><% } %><% videos.forEach(function(video){ const title=lang==='el'?(video.titleEl||video.titleEn):(video.titleEn||video.titleEl); const desc=lang==='el'?(video.descriptionEl||video.descriptionEn):(video.descriptionEn||video.descriptionEl); const locked=video.accessLevel==='subscriber'&&!subscription.active; %><a class="card <%= locked?'locked':'' %>" data-category="<%= video.category %>" href="<%= withTenantLink('/content/'+video.slug) %>"><% if(video.thumbnailUrl){ %><img src="<%= video.thumbnailUrl %>" alt=""><% }else{ %><div class="placeholder">▶</div><% } %><div class="body"><h2><%= title %></h2><p><%= desc %></p><div class="meta"><span><%= video.accessLevel==='public'?(lang==='el'?'Δημόσιο':'Public'):(locked?'🔒 '+(lang==='el'?'Συνδρομητές':'Subscribers'):'▶ '+(lang==='el'?'Παρακολούθηση':'Watch')) %></span><span><%= video.durationSeconds?Math.floor(video.durationSeconds/60)+':'+String(video.durationSeconds%60).padStart(2,'0'):'' %></span></div></div></a><% }) %></main><script>document.querySelectorAll('[data-category]').forEach(function(button){if(button.tagName!=='BUTTON')return;button.addEventListener('click',function(){document.querySelectorAll('.filters button').forEach(function(b){b.classList.remove('active')});button.classList.add('active');document.querySelectorAll('#video-grid .card').forEach(function(card){card.hidden=button.dataset.category!=='all'&&card.dataset.category!==button.dataset.category})})});</script></body></html>
