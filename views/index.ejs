      body.eko-header-clean .store-header::after,
      body.eko-header-clean .eko-header-bg-logo { display:none !important; content:none !important; }
      body.eko-header-clean .header-main-row { display:contents; }
      body.eko-header-clean .logo-title { grid-column:1; align-self:center; }
      body.eko-header-clean .header-mode-toggle-slot,
      body.eko-header-clean .header-auth-actions { display:none !important; }
      body.eko-header-clean .eko-header-compact-logo { padding:0; min-width:150px; }
      body.eko-header-clean .eko-header-compact-logo img { height:34px; max-width:130px; }
      body.eko-header-clean .eko-header-compact-logo .eko-compact-sub { display:none; }
      body.eko-header-clean .header-nav-row { display:contents; }
      body.eko-header-clean .header-nav-row .main-nav { grid-column:2; grid-row:1; padding:0 22px; background:transparent; min-width:0; }
      body.eko-header-clean .header-nav-row ul { justify-content:center; gap:24px; overflow:visible; }
      body.eko-header-clean .header-nav-row ul li a { min-width:0; padding:18px 0; border:0; border-radius:0; background:none; box-shadow:none; color:#f5f5f5; font-size:.73rem; letter-spacing:.045em; }
      body.eko-header-clean .header-nav-row ul li a::before { display:none !important; content:none !important; animation:none !important; }
      body.eko-header-clean .header-nav-row ul li a::after { content:"" !important; display:block !important; position:absolute; left:0; right:auto; bottom:10px; width:0; height:2px; border:0; background:var(--eko-accent); opacity:0; box-shadow:0 0 7px color-mix(in srgb,var(--eko-accent) 30%,transparent); transition:width .2s ease, opacity .2s ease; }
      body.eko-header-clean .header-nav-row ul li:hover a::after,
      body.eko-header-clean .header-nav-row ul li.active a::after { width:100%; opacity:1; }
      body.eko-header-clean .header-nav-row ul:has(li:hover) li.active:not(:hover) a::after { opacity:.4; }
      body.eko-header-clean .header-nav-row ul li a:hover,
      body.eko-header-clean .header-nav-row ul li.active a { color:var(--eko-accent); background:none; transform:none; box-shadow:none; }
      body.eko-header-clean .eko-header-actions { grid-column:3; grid-row:1; margin:0; z-index:3; }
      body.eko-header-clean .eko-header-icon-btn { border-color:#333; background:#111; }
      body.eko-header-clean .eko-clean-menu-toggle { display:none; grid-column:4; grid-row:1; }
      body.eko-header-clean .eko-nav-lang { display:block; grid-column:4; grid-row:1; margin-left:8px; }
      body.eko-header-clean .eko-hero { margin:0 calc(50% - 50vw) 28px; border:0; border-radius:0; }
      body.eko-header-clean .eko-hero-img { height:clamp(360px,48vw,680px); object-fit:cover; }
      .eko-account-utility { margin:28px auto 0; padding:18px; display:flex; justify-content:center; align-items:center; gap:12px; border-top:1px solid var(--eko-border); color:var(--eko-text-muted); }
      .eko-account-utility a { color:var(--eko-accent); text-decoration:none; font-size:.82rem; font-weight:700; }
      @media (max-width:900px) {
        body.eukolakis-classic.eko-header-clean .store-header { grid-template-columns:minmax(0,1fr) auto auto; padding:0 12px; }
        body.eko-header-clean .logo-title { grid-column:1; grid-row:1; }
        body.eko-header-clean .eko-header-actions { grid-column:2; }
        body.eko-header-clean .eko-clean-menu-toggle { display:inline-flex; align-items:center; justify-content:center; grid-column:3; width:38px; height:38px; margin-left:6px; padding:0; background:#151515; color:#fff; border:1px solid #333; border-radius:8px; font-size:1.25rem; }
        body.eko-header-clean .header-nav-row { display:block; grid-column:1/-1; grid-row:2; width:calc(100% + 24px); margin-left:-12px; }
        body.eko-header-clean .main-nav { display:none; }
        body.eko-header-clean .main-nav.open { display:block; padding:8px 18px 14px; border-top:1px solid #242424; background:#090909; }
        body.eko-header-clean .header-nav-row ul { display:grid; grid-template-columns:1fr; gap:0; }
        body.eko-header-clean .header-nav-row ul li a { padding:12px 0; }
        body.eko-header-clean .header-nav-row ul li a::after { display:none !important; }
        body.eko-header-clean .header-nav-row ul li.active a { border-left:2px solid var(--eko-accent) !important; padding-left:10px; }
        body.eko-header-clean .eko-nav-lang { display:block; padding:0 18px 14px; margin:0; background:#090909; }
        body.eko-header-clean .main-nav:not(.open) + .eko-nav-lang { display:none; }
      }
      @media (max-width:600px) {
        body.eko-header-clean .eko-header-compact-logo { min-width:0; flex:1; }
        body.eko-header-clean .eko-header-compact-logo .eko-compact-name { display:none; }
        body.eko-header-clean .eko-header-search { display:none; }
        body.eko-header-clean .eko-header-actions { flex:0 0 auto; margin:0; }
        body.eko-header-clean .eko-hero-img { height:clamp(220px,62vw,360px); }
      }
      <% const _sfBgUrl = (config.theme && config.theme.storefrontBgUrl) || ''; %>
      <% if (_sfBgUrl) { %>
      body.eukolakis-classic { background: transparent; }
      body.eukolakis-classic::before {
        content: '';
        position: fixed; inset: 0; z-index: -1;
        background: url('<%= _sfBgUrl %>') center/cover no-repeat fixed;
      }
      body.eukolakis-classic::after {
        content: '';
        position: fixed; inset: 0; z-index: -1;
        background: rgba(11,13,18,.82);
      }
      body.eukolakis-classic main,
      body.eukolakis-classic .store-footer { position: relative; z-index: 0; }
      <% } %>
    </style>
  </head>
  <body class="device-<%= device || 'desktop' %> os-<%= os || 'other' %> card-density-<%= ((config.theme && config.theme.cardDensity) || 'normal') %> home-layout-<%= ((config.theme && config.theme.homeLayoutPreset) || 'split') %> <%= config.theme && config.theme.presetId === 'eukolakis_classic_diy' ? ('eukolakis-classic eko-header-' + ((config.theme && config.theme.headerMenuStyle) || 'clean')) : '' %>" id="eko-body">
    <% const theme = config.theme || {}; %>
    <% const homepage = config.homepage || {}; %>
    <% const assetAudit = storefrontAssetAudit || {}; %>
    <% const headerBannerAudit = assetAudit.headerBanner || null; %>
    <% const headerBrandAssetSrc = (headerBannerAudit && headerBannerAudit.exists && headerBannerAudit.url) ? headerBannerAudit.url : (config.logoPath || ''); %>
    <% const navMenuPlateAudit = Array.isArray(assetAudit.navMenuPlates) ? assetAudit.navMenuPlates : []; %>
    <% const navPlateExistsByUrl = navMenuPlateAudit.reduce(function(acc, item){ if (item && item.url) acc[item.url] = !!item.exists; return acc; }, {}); %>
    <% const homeBlockVisibility = Object.assign({ hero: true, kits: true, spare: true, subscriptions: true }, (homepage && homepage.blockVisibility) || {}); %>
    <% const homeBlockContent = Object.assign({ kitsTitle: '', spareTitle: '', subscriptionsTitle: '' }, (homepage && homepage.blockContent) || {}); %>
    <% const topFeaturedPrimary = Array.isArray(homepage.featuredPrimary) ? homepage.featuredPrimary : (Array.isArray(homepage.featuredIds) ? homepage.featuredIds.slice(0,2) : []); %>
    <% const topPrimaryKit1 = (allProducts || products).find(function(p){ return p.id === topFeaturedPrimary[0]; }) || (allProducts || products).find(function(p){ return p.type === 'KIT'; }); %>
    <% const topPrimaryKit2 = (allProducts || products).find(function(p){ return p.id === topFeaturedPrimary[1]; }) || (allProducts || products).filter(function(p){ return p.type === 'KIT'; })[1]; %>
    <% const isEukolakisClassic = theme.presetId === 'eukolakis_classic_diy'; %>
    <% const isCleanHeader = isEukolakisClassic && theme.headerMenuStyle !== 'industrial_plates'; %>
    <% const useCodeTabs = isEukolakisClassic && String(theme.categoryMenuStyle || '').trim().toLowerCase() === 'code_tabs'; %>
    <% const hideMenuForHeroFocus = false; %>
    <% const navCategories = categories.filter(function(c){ return c.showInMainNav !== false; }).sort(function(a,b){ return (Number(a.navOrder) || 999) - (Number(b.navOrder) || 999); }); %>
    <% const storefrontCategories = categories.filter(function(c){ return c.visible !== false; }).sort(function(a,b){ return (Number(a.navOrder) || 999) - (Number(b.navOrder) || 999); }); %>
    <% const brandingMode = theme.brandingMode || 'logo_name'; %>
    <% const logoBgMode = theme.logoBgMode || 'auto'; %>
    <% const logoFrameClass = logoBgMode === 'dark_badge' ? 'logo-frame-dark' : (logoBgMode === 'light_badge' ? 'logo-frame-clean' : (logoBgMode === 'none' ? '' : 'logo-frame-floating')); %>
    <% const logoDisplayMode = theme.logoDisplayMode || 'contain'; %>
    <% const transparentBlendMode = logoDisplayMode === 'transparent_blend'; %>
    <% const effectiveLogoFrameClass = (transparentBlendMode ? 'logo-transparent-safe' : logoFrameClass); %>
    <% const logoDefaultHeight = isEukolakisClassic ? 96 : 88; %>
    <% const logoRequestedHeight = Number(theme.logoMaxHeight || logoDefaultHeight); %>
    <% const logoMaxHeight = Math.max(56, Math.min(120, logoRequestedHeight || logoDefaultHeight)); %>
    <% const logoMobileHeight = Math.max(40, Math.min(86, Math.round(logoMaxHeight * 0.72))); %>
    <% const logoPadding = Math.max(0, Math.min(24, Number(theme.logoPadding || 6))); %>
    <% const logoRadius = Math.max(0, Math.min(36, Number(theme.logoRadius || 10))); %>
    <% const logoShadowMode = (theme.logoShadow === 'none' || theme.logoShadow === 'floating') ? theme.logoShadow : 'soft'; %>
    <% const hasLogoBg = !!effectiveLogoFrameClass; %>
    <% const logoFilterShadow = logoShadowMode === 'floating' ? 'drop-shadow(0 12px 18px rgba(15,23,42,.28))' : (logoShadowMode === 'soft' ? 'drop-shadow(0 6px 10px rgba(15,23,42,.22))' : 'none'); %>
    <% const logoBoxShadow = hasLogoBg ? (logoShadowMode === 'floating' ? '0 16px 28px rgba(15,23,42,.22)' : (logoShadowMode === 'soft' ? '0 4px 12px rgba(15,23,42,.12)' : 'none')) : 'none'; %>
    <% const subscriptionsEnabled = !!homepage.showSubscriptionsCard; %>
    <% const subscriptionVideoCard = homepage.subscriptionVideoCard || {}; %>
    <% const subscriptionVideoTitle = resolveField(subscriptionVideoCard.title, lang) || (lang === 'el' ? 'Συνδρομητικά βίντεο επισκευών' : 'Subscription repair videos'); %>
    <% const subscriptionVideoSubtitle = resolveField(subscriptionVideoCard.subtitle, lang) || ''; %>
    <% const subscriptionVideoHrefRaw = subscriptionVideoCard.href || '/content'; %>
    <% const subscriptionVideoHref = /^https?:\/\//i.test(subscriptionVideoHrefRaw) ? subscriptionVideoHrefRaw : withTenantLink(subscriptionVideoHrefRaw.charAt(0) === '/' ? subscriptionVideoHrefRaw : ('/' + subscriptionVideoHrefRaw), lang !== 'el' ? { lang } : {}); %>
    <% const subscriptionVideoConfigured = !!(subscriptionVideoCard.image || resolveField(subscriptionVideoCard.title, lang) || resolveField(subscriptionVideoCard.subtitle, lang)); %>
    <% const hideStoreNameForClassicBanner = isEukolakisClassic && brandingMode === 'logo_name' && !!config.logoPath; %>
    <% const authPosition = (theme.authPosition === 'left') ? 'left' : 'right'; %>
    <% const menuStyle = ['classic', 'pills', 'compact'].includes(theme.menuStyle) ? theme.menuStyle : 'classic'; %>
    <% const safeJson = function(value){ return JSON.stringify(value).replace(/</g, '\\u003c').replace(/-->/g, '--\\u003e').replace(/<\/script/gi, '<\\/script'); }; %>
    <% const ekoHeroMode = isEukolakisClassic ? String((theme.headerHeroHomepage || 'centered-background')) : 'off'; %>
    <% const ekoHeroEnabled = isEukolakisClassic && !isCleanHeader ? (ekoHeroMode !== 'off') : false; %>
    <% const ekoHeroOpacity = Number(theme.headerHeroLogoOpacity != null ? theme.headerHeroLogoOpacity : 0.22); %>
    <% const ekoFgMode = isEukolakisClassic ? String((theme.headerFgHomepage || 'hidden')) : 'normal'; %>
    <% const ekoFgMaxHeight = Math.max(28, Math.min(120, Number(theme.headerForegroundLogoMaxHeight || 42))); %>
    <header class="store-header <%= isEukolakisClassic ? 'premium' : '' %> header-logo-foreground-<%= ekoFgMode %> <%= ekoHeroEnabled ? 'header-hero-logo-enabled' : 'header-hero-logo-disabled' %> auth-pos-<%= authPosition %> branding-mode-<%= brandingMode %> <%= ekoHeroEnabled ? 'eko-hero-on' : 'eko-hero-off' %> <%= ('fg-logo-' + ekoFgMode) %> <%= ('hero-mode-' + ekoHeroMode) %>" style="<%= isEukolakisClassic ? ('--eko-hero-logo-opacity:' + ekoHeroOpacity + ';--eko-foreground-logo-max-height:' + ekoFgMaxHeight + 'px;') : '' %>">
      <% if (isEukolakisClassic && headerBrandAssetSrc && ekoHeroEnabled) { %>
        <div class="eko-header-bg-logo" aria-hidden="true"><img src="<%= headerBrandAssetSrc %>" alt="" /></div>
      <% } %>
      <div class="header-main-row">
      <% if (isEukolakisClassic && !isCleanHeader) { %><div class="header-mode-toggle-slot" aria-label="Color mode toggle slot"></div><% } %>
      <div class="logo-title <%= theme.headerLayout === 'centered' ? 'centered' : '' %> <%= isEukolakisClassic ? 'classic-branding' : '' %>">
        <% if (isEukolakisClassic) { %>
          <a class="eko-header-compact-logo" href="<%= withTenantLink('/', lang !== 'el' ? { lang } : {}) %>">
            <% if (config.logoPath) { %><img src="<%= config.logoPath %>" alt="<%= config.storeName %>" /><% } %>
            <div>
              <div class="eko-compact-name"><%= config.storeName %></div>
              <div class="eko-compact-sub"><%= lang === 'el' ? 'Industrial Systems' : 'Industrial Systems' %></div>
            </div>
          </a>
        <% } else if (config.logoPath && brandingMode !== 'name_only') { %>
          <span class="logo-frame <%= effectiveLogoFrameClass %>" style="padding:<%= logoPadding %>px;border-radius:<%= logoRadius %>px;box-shadow:<%= logoBoxShadow %>;--logo-max-height-desktop:<%= logoMaxHeight %>px;--logo-max-height-mobile:<%= logoMobileHeight %>px;">
            <img src="<%= config.logoPath %>" alt="<%= config.storeName %>" class="logo logo-image logo-image-dynamic <%= logoDisplayMode %>" style="max-height:<%= logoMaxHeight %>px;filter:<%= logoFilterShadow %>;" />
          </span>
        <% } %>
        <% if (brandingMode !== 'logo_only' && !hideStoreNameForClassicBanner) { %>
        <div class="store-name-wrap">
          <h1><%= config.storeName %></h1>
          <% if (config.web3Domain) { %>
            <p class="subtitle"><%= t('storefront.web3Domain') %>: <%= config.web3Domain %></p>
          <% } %>
        </div>
        <% } %>
        <% if (brandingMode === 'logo_only') { %>
        <div class="store-name-wrap logo-only-fallback"><%= config.storeName %></div>
        <% } %>
      </div>
      <% if (isEukolakisClassic) { %>
      <div class="eko-header-actions">
        <form class="eko-header-search" action="<%= withTenantLink('/', {}) %>" method="GET">
          <input type="search" name="q" placeholder="<%= lang === 'el' ? 'Αναζήτηση...' : 'Search...' %>" value="<%= (typeof query !== 'undefined' && query) || '' %>" autocomplete="off" />
          <button type="submit" aria-label="<%= lang === 'el' ? 'Αναζήτηση' : 'Search' %>"><svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg></button>
        </form>
        <a class="eko-header-icon-btn" href="<%= withTenantLink(user ? '/account' : '/login', lang !== 'el' ? { lang } : {}) %>" title="<%= lang === 'el' ? 'Λογαριασμός' : 'Account' %>">
          <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
        </a>
        <a class="eko-header-icon-btn" href="<%= withTenantLink('/checkout', lang !== 'el' ? { lang } : {}) %>" title="<%= lang === 'el' ? 'Καλάθι' : 'Cart' %>">
          <svg viewBox="0 0 24 24"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1.003 1.003 0 0020 4H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg>
          <span class="eko-badge" id="eko-cart-badge" style="display:none;">0</span>
        </a>
        <% const _vaHdr = (config && config.assistant) || {}; %>
        <% if (_vaHdr.vaEnabled && ['customer','both'].includes(_vaHdr.vaMode)) { %>
        <button class="eko-header-icon-btn" id="eko-header-chat-btn" title="<%= lang === 'el' ? 'Βοηθός' : 'Assistant' %>" type="button">
          <svg viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"/></svg>
        </button>
        <% } %>
      </div>
      <% if (!isCleanHeader) { %><div class="header-auth-actions">
        <% if (!user) { %>
          <a class="button" href="<%= withTenantLink('/login', lang !== 'el' ? { lang } : {}) %>"><%= lang === 'el' ? 'Σύνδεση' : 'Login' %></a>
          <a class="button" href="<%= withTenantLink('/signup', lang !== 'el' ? { lang } : {}) %>"><%= lang === 'el' ? 'Εγγραφή' : 'Signup' %></a>
        <% } else { %>
          <a class="button" href="<%= withTenantLink('/account', lang !== 'el' ? { lang } : {}) %>"><%= lang === 'el' ? 'Ο Λογαριασμός μου' : 'My Account' %></a>
          <a class="button" href="<%= withTenantLink('/logout', lang !== 'el' ? { lang } : {}) %>"><%= lang === 'el' ? 'Αποσύνδεση' : 'Logout' %></a>
        <% } %>
      </div><% } %>
      <% } %>
      <% if (isCleanHeader) { %><button class="menu-toggle eko-clean-menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="<%= lang === 'el' ? 'Άνοιγμα μενού' : 'Open menu' %>">☰</button><% } %>
      </div>
      <% if (!hideMenuForHeroFocus) { %>
      <div class="header-nav-row">
      <% if (!isCleanHeader) { %><button class="menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav"><%= t('storefront.menuToggle') %></button><% } %>
      <nav class="main-nav menu-style-<%= menuStyle %>" id="main-nav">
        <ul>
          <% if (isCleanHeader) { %><li class="<%= !activeCategory ? 'active' : '' %>"><a href="<%= withTenantLink('/', lang !== 'el' ? { lang } : {}) %>"><%= lang === 'el' ? 'ΑΡΧΙΚΗ' : 'HOME' %></a></li><% } %>
          <% if (!isEukolakisClassic) { %>
          <li class="<%= !activeCategory ? 'active' : '' %>">
            <a href="<%= withTenantLink('/', lang !== 'el' ? { lang } : {}) %>"><%= t('storefront.allProducts') %></a>
          </li>
          <% } %>
          <% (isEukolakisClassic ? navCategories : categories).forEach(function(cat) { %>
            <% if (!isEukolakisClassic && theme.categoryMenuStyle && theme.categoryMenuStyle !== 'text') { return; } %>
            <li class="<%= activeCategory === cat.slug ? 'active' : '' %>">
              <a href="<%= withTenantLink('/', Object.assign({ category: cat.slug }, lang !== 'el' ? { lang } : {})) %>">
                <% if (isEukolakisClassic && !isCleanHeader && !useCodeTabs) { %>
                  <% if (cat.image) { %>
                    <img src="<%= cat.image + '?v=' + (cat.imageVersion || 1) %>" alt="" class="eko-nav-plate-thumb" loading="lazy"
                      onerror="this.style.display='none';var nx=this.nextElementSibling;if(nx)nx.style.display='inline-flex';" />
                    <span class="eko-nav-plate-fallback" style="display:none;"><%= (cat.name || 'CAT').slice(0,3).toUpperCase() %></span>
                  <% } else { %>
                    <span class="eko-nav-plate-fallback"><%= (cat.name || 'CAT').slice(0,3).toUpperCase() %></span>
                  <% } %>
                <% } else if (isEukolakisClassic && useCodeTabs) { %>
                  <span class="eko-nav-plate-fallback"><%= (cat.name || 'CAT').slice(0,3).toUpperCase() %></span>
                <% } else if (cat.image) { %>
                  <img src="<%= cat.image + '?v=' + (cat.imageVersion || 1) %>" alt="<%= cat.name %>" class="cat-logo" />
                <% } %>
                <%= cat.name %>
              </a>
            </li>
