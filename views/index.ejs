        if (slot) slot.appendChild(btn);
        else document.body.appendChild(btn);
        applyMode(current);
        btn.addEventListener('click', function() {
          current = body.classList.contains('eko-light') ? 'dark' : 'light';
          applyMode(current);
        });
      })();
    </script>

<%
  const _vaCfg = (config && config.assistant) ? config.assistant : {};
  const _vaLangEff = (_vaCfg.vaLanguage === 'auto') ? lang : (_vaCfg.vaLanguage || 'el');
%>
<% if (_vaCfg.vaEnabled && ['customer','both'].includes(_vaCfg.vaMode)) { %>
<style>
  #thrc-chat-fab {
    position: fixed; bottom: 28px; right: 28px; z-index: 9999;
    width: 56px; height: 56px; border-radius: 50%;
    background: var(--eko-accent, #c4902e); color: #fff;
    border: none; cursor: pointer; font-size: 24px;
    box-shadow: 0 4px 18px rgba(0,0,0,.35);
    display: flex; align-items: center; justify-content: center;
    transition: transform .15s, box-shadow .15s;
  }
  #thrc-chat-fab:hover { transform: scale(1.08); box-shadow: 0 6px 24px rgba(0,0,0,.45); }
  #thrc-chat-panel {
    position: fixed; bottom: 96px; right: 28px; z-index: 9999;
    width: 340px; max-height: 480px;
    background: var(--eko-surface, #1a1a1a); border: 1px solid var(--eko-border, #333);
    border-radius: 16px; overflow: hidden;
    display: flex; flex-direction: column;
    box-shadow: 0 8px 32px rgba(0,0,0,.5);
    font-family: system-ui, sans-serif;
    transition: opacity .2s, transform .2s;
  }
  #thrc-chat-panel[hidden] { display: none; }
  #thrc-chat-header {
    padding: 12px 16px; display: flex; align-items: center; justify-content: space-between;
    background: var(--eko-accent, #c4902e); color: #fff; font-weight: 700; font-size: .88rem;
  }
  #thrc-chat-header button {
    background: none; border: none; color: #fff; font-size: 18px; cursor: pointer; line-height: 1;
  }
  #thrc-chat-messages {
    flex: 1; overflow-y: auto; padding: 12px 14px;
    display: flex; flex-direction: column; gap: 8px;
    background: var(--eko-bg, #111);
  }
  .thrc-msg { max-width: 85%; padding: 8px 12px; border-radius: 12px; font-size: .82rem; line-height: 1.4; }
  .thrc-msg-bot {
    align-self: flex-start;
    background: var(--eko-surface, #222); color: var(--eko-text, #eee);
    border-bottom-left-radius: 4px;
  }
  .thrc-msg-user {
    align-self: flex-end;
    background: var(--eko-accent, #c4902e); color: #fff;
    border-bottom-right-radius: 4px;
  }
  .thrc-msg-error { align-self: center; color: #f87171; font-size: .78rem; font-style: italic; }
  #thrc-chat-typing { align-self: flex-start; padding: 8px 12px; font-size: .75rem; color: var(--eko-text-muted, #888); }
  #thrc-chat-input-row {
    display: flex; gap: 6px; padding: 10px 12px;
    border-top: 1px solid var(--eko-border, #333);
    background: var(--eko-surface, #1a1a1a);
  }
  #thrc-chat-input {
    flex: 1; background: var(--eko-bg, #111); border: 1px solid var(--eko-border, #333);
    color: var(--eko-text, #eee); border-radius: 8px;
    padding: 7px 10px; font-size: .82rem; outline: none;
  }
  #thrc-chat-input:focus { border-color: var(--eko-accent, #c4902e); }
  #thrc-chat-send {
    background: var(--eko-accent, #c4902e); color: #fff;
    border: none; border-radius: 8px; padding: 7px 14px; cursor: pointer; font-size: .85rem;
  }
  #thrc-chat-send:disabled { opacity: .5; cursor: default; }
  @media (max-width: 420px) {
    #thrc-chat-panel { width: calc(100vw - 24px); right: 12px; }
  }
</style>

<button id="thrc-chat-fab" aria-label="Βοηθός" title="Εικονικός Βοηθός">💬</button>

<div id="thrc-chat-panel" hidden>
  <div id="thrc-chat-header">
    <span><%- _vaLangEff === 'en' ? 'Virtual Assistant' : 'Εικονικός Βοηθός' %></span>
    <button id="thrc-chat-close" aria-label="Κλείσιμο">✕</button>
  </div>
  <div id="thrc-chat-messages">
    <div class="thrc-msg thrc-msg-bot"><%- _vaLangEff === 'en' ? 'Hello! How can I help you today?' : 'Γεια σας! Πώς μπορώ να σας βοηθήσω σήμερα;' %></div>
  </div>
  <div id="thrc-chat-input-row">
    <input id="thrc-chat-input" type="text"
      placeholder="<%- _vaLangEff === 'en' ? 'Type a message…' : 'Γράψτε ένα μήνυμα…' %>"
      maxlength="500" autocomplete="off" />
    <button id="thrc-chat-send">&#10148;</button>
  </div>
</div>

<script>
(function() {
  var fab = document.getElementById('thrc-chat-fab');
  var panel = document.getElementById('thrc-chat-panel');
  var closeBtn = document.getElementById('thrc-chat-close');
  var messages = document.getElementById('thrc-chat-messages');
  var input = document.getElementById('thrc-chat-input');
  var sendBtn = document.getElementById('thrc-chat-send');
  var chatApiUrl = <%- JSON.stringify(withTenantLink('/api/chat')) %>;
  var isLoading = false;

  function appendMsg(text, cls) {
    var div = document.createElement('div');
    div.className = 'thrc-msg ' + cls;
    div.textContent = text;
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
    return div;
  }

  fab.addEventListener('click', function() {
    panel.hidden = !panel.hidden;
    if (!panel.hidden) { input.focus(); }
  });

  var headerChatBtn = document.getElementById('eko-header-chat-btn');
  if (headerChatBtn) {
    headerChatBtn.addEventListener('click', function() {
      panel.hidden = !panel.hidden;
      if (!panel.hidden) { input.focus(); }
    });
  }

  closeBtn.addEventListener('click', function() { panel.hidden = true; });

  function sendMessage() {
    var msg = input.value.trim();
    if (!msg || isLoading) return;
    input.value = '';
    appendMsg(msg, 'thrc-msg-user');
    isLoading = true;
    sendBtn.disabled = true;
    var typingEl = document.createElement('div');
    typingEl.id = 'thrc-chat-typing';
    typingEl.textContent = '…';
    messages.appendChild(typingEl);
    messages.scrollTop = messages.scrollHeight;

    fetch(chatApiUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: msg })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (typingEl.parentNode) typingEl.parentNode.removeChild(typingEl);
      if (data && data.response) {
        appendMsg(data.response, 'thrc-msg-bot');
      } else if (data && data.error) {
        appendMsg(data.error, 'thrc-msg-error');
      }
    })
    .catch(function() {
      if (typingEl.parentNode) typingEl.parentNode.removeChild(typingEl);
      appendMsg('Σφάλμα σύνδεσης. Δοκιμάστε ξανά.', 'thrc-msg-error');
    })
    .finally(function() {
      isLoading = false;
      sendBtn.disabled = false;
      input.focus();
    });
  }

  sendBtn.addEventListener('click', sendMessage);
  input.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') sendMessage();
  });
})();
</script>
<% } %>

  </body>
</html>
