      /* Clean is a selectable presentation layer; the original plate rules above
         remain intact and are activated by .eko-header-industrial_plates. */
      body.eukolakis-classic.eko-header-clean .store-header { position:static; top:auto; display:grid; grid-template-columns:auto minmax(0,1fr) auto auto; align-items:center; min-height:64px !important; padding:0 22px; background:#090909 !important; box-shadow:none !important; border-bottom:1px solid #242424 !important; backdrop-filter:none; overflow:visible; }
      .header-logo-foreground-hidden .logo-title { /* stable mode hook used by theme previews */ }
